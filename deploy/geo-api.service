[Unit]
Description=GEO 监测 API（FastAPI）
Documentation=file:///opt/geo/backend/docs/02-deploy.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/geo/backend

# 只监听回环，外部一律走 Nginx。
# 配置读的是 WorkingDirectory 下的 .env，不要在这里写 EnvironmentFile，
# 否则会被 systemd 的引号规则坑到（密码里的 # 和 $ 会被吃掉）。
ExecStart=/opt/geo/backend/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8000 \
    --workers 2 \
    --proxy-headers --forwarded-allow-ips=127.0.0.1

Restart=always
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGINT

# 基础加固：不给提权、私有 /tmp、系统目录只读，只放开工作目录
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/geo/backend

[Install]
WantedBy=multi-user.target
