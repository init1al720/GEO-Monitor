# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不会进版本库
APP_NAME=geo-backend
APP_VERSION=0.1.0

# 运行环境：local | dev | staging | prod
ENV=local
DEBUG=true

# HTTP 服务
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# 跨域，多个来源用英文逗号分隔；* 表示不限制（生产环境请写具体域名）
CORS_ORIGINS=*

# 日志：级别 / 是否输出 JSON（生产建议 true，本地调试可 false）
LOG_LEVEL=INFO
LOG_JSON=false

# 链路追踪请求头
REQUEST_ID_HEADER=X-Request-ID

# ---------- 数据库 ----------
# 开发：SQLite 零安装，文件放在 data/（已 gitignore）
DATABASE_URL=sqlite+aiosqlite:///./data/geo.db
# 生产：Postgres（异步驱动 asyncpg）
# DATABASE_URL=postgresql+asyncpg://geo:密码@127.0.0.1:5432/geo

# ---------- 鉴权 ----------
# 生产环境必须替换：openssl rand -hex 32
JWT_SECRET=dev-only-change-me
JWT_EXPIRE_HOURS=24

