# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不会进版本库
APP_NAME=geo-backend
APP_VERSION=0.1.0

# 运行环境：local | dev | staging | prod
ENV=local
DEBUG=true

# HTTP 服务
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# 跨域，多个来源用英文逗号分隔；* 表示不限制（生产环境请写具体域名）
CORS_ORIGINS=*
# 前端在 Vercel，预览域名每次部署都变，用正则兜住整段；
# 生产环境示例：^https://geo-monitor(-[a-z0-9-]+)?\.vercel\.app$
CORS_ORIGIN_REGEX=

# 日志：级别 / 是否输出 JSON（生产建议 true，本地调试可 false）
LOG_LEVEL=INFO
LOG_JSON=false

# 链路追踪请求头
REQUEST_ID_HEADER=X-Request-ID

# 报告口径时区：daily_metrics.metric_date 按这个时区切天（落库的 called_at 始终是 UTC）
# 国内客户用 Asia/Shanghai；不填默认就是它
REPORT_TIMEZONE=Asia/Shanghai

# ---------- 数据库 ----------
# 本地开发：SQLite 零安装，文件放 data/（已 gitignore）
DATABASE_URL=sqlite+aiosqlite:///./data/geo.db
# 线上：Supabase Session pooler（IPv4 可直连；直连串在 IPv6-only 的机器上会 ENETUNREACH）
# 采集器用这条串写入，不受 RLS 约束
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<密码>@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres
# 串里带不带 ?sslmode=require 都行，代码会翻译成 asyncpg 认识的参数
# （asyncpg 不认 sslmode，原样传会报 unrecognized configuration parameter）

# 是否打印 SQL（排查聚合问题时临时开）
DB_ECHO=false
# SSL 模式：留空自动判断（远程库 require，本地不加密）；也可写 disable / require
DB_SSL=
# 连接池。Session pooler 的连接数有配额（免费档约 15），别开太大
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# ---------- 采集：通用参数 ----------
# 并发上限，各家限流不同，先保守取 3
COLLECT_CONCURRENCY=3
# 单个回答的超时秒数
ENGINE_TIMEOUT_SECONDS=120
# 最多尝试次数（1 次首发 + 2 次重试）。只有超时、429、5xx 会重试，
# 401/400 这类配置错误立即失败，不白等
ENGINE_MAX_ATTEMPTS=3
# 重试退避基数，第 n 次等待 base*4^(n-1)：30s、120s；429 带 Retry-After 时以它为准
ENGINE_RETRY_BASE_SECONDS=30
# 单次 run 最多跑多少个问题，防止误操作打出几百个请求
COLLECT_MAX_PROMPTS=50
# 采集成功后自动重算当天指标（关掉的话看板要等手动重算）
COLLECT_AUTO_METRICS=true
# 超过这个分钟数还停在 pending/running 的批次视为中断，不再阻塞新采集
COLLECT_STALE_MINUTES=180

# ---------- 采集：各家引擎密钥（填哪家就能跑哪家）----------
# DeepSeek：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 通义千问（DashScope 兼容模式）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 豆包（火山方舟 v3）
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-pro-32k

# ---------- 鉴权（token 由 Supabase 签发，后端只校验）----------
# Dashboard → Settings → API → Project URL，结尾不带斜杠
SUPABASE_URL=
# 老项目是 HS256 签名，需要填 JWT Secret（Settings → API → JWT Secret）；
# 新项目默认非对称签名（ES256/RS256），不用填，公钥自动从 JWKS 拉取
SUPABASE_JWT_SECRET=
# token 的 aud 声明，Supabase 固定是 authenticated，一般不用改
SUPABASE_JWT_AUDIENCE=authenticated

